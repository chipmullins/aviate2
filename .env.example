# Copy to .env with ./setup.sh (fills in the secrets), or copy it by hand and fill them in yourself.
# Never commit .env.

# ---- Secrets (setup.sh generates these) ----
APP_KEY=
DB_PASSWORD=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ---- Public server with HTTPS (see DEPLOY.md) ----
# Uncomment on the server: starts Caddy, which gets the HTTPS certificate for AVIATE_DOMAIN.
# COMPOSE_PROFILES=https
# AVIATE_DOMAIN=aviate.glofly.app
# With Caddy in front, keep the web container private to the server:
# WEB_BIND=127.0.0.1

# ---- Public demo ----
# true = "Try the demo" buttons on the login page, sample accounts can't be changed,
# and everything is wiped and re-seeded every night at DEMO_RESET_AT (Eastern time).
DEMO_MODE=false
DEMO_RESET_AT=04:00

# ---- Where people reach Aviate ----
# Local: http://localhost:8080. On a server, use its address, e.g. http://203.0.113.10:8080 or https://aviate.example.com
APP_URL=http://localhost:8080
WEB_PORT=8080
# Host:port the browser uses (comma-separated). Must match APP_URL's host and port.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:4200
# Host names only, no port.
REVERB_ALLOWED_ORIGINS=localhost
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

# ---- App ----
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=info
# Fill the database with sample crew members, posts and messages on first start.
SEED_DEMO_DATA=true
# Set to 1 for production images (leaves out PHPUnit and other dev tools).
COMPOSER_NO_DEV=0

# Behind a load balancer (e.g. AWS ALB)? Set TRUSTED_PROXIES=* so rate limits see real client IPs.
TRUSTED_PROXIES=

AVIATE_ALLOWED_EMAIL_DOMAINS=united.com,delta.com,aa.com,allegiant.com,suncountry.com,jetblue.com,southwest.com
